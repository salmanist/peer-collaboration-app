# Copy this file to .env and replace the placeholder values with your local
# PostgreSQL credentials. Never commit backend/.env.
DJANGO_SECRET_KEY=replace-with-a-long-random-development-secret

DB_NAME=fyp_dev
DB_USER=fyp_dev_user
DB_PASSWORD=replace-with-the-password-for-fyp_dev_user
DB_HOST=localhost
DB_PORT=5432
