{
  "expo": {
    "name": "Fello",
    "slug": "felloo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lgupeer",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0C4A38",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.sz.fello"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withLocalPreviewHttp",
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LGU Peer uses your location to suggest nearby ride matches when you offer or search for a ride."
        }
      ],
      "expo-font",
      "./plugins/withSingleAndroidSplash",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/fello-launch.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "android": {
            "image": "./assets/splash-icon.png",
            "imageWidth": 72,
            "backgroundColor": "#FFFFFF"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6bb54afb-bfaf-4ac9-bc8b-ecdb3629106b"
      }
    },
    "owner": "salmansaeed16"
  }
}
